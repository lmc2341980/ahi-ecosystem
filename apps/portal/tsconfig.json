{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@ahi/shared": [
        "../../packages/shared/src"
      ],
      "@ahi/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@ahi/sdk": [
        "../../packages/sdk/src"
      ],
      "@ahi/ui": [
        "../../packages/ui/src"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".turbo"
  ],
  "references": [
    {
      "path": "../../packages/shared"
    },
    {
      "path": "../../packages/sdk"
    },
    {
      "path": "../../packages/ui"
    }
  ]
}
